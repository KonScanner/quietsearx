# Copy this file to .env, then set your own values.
#   cp .env.example .env
# The .env file stays out of git. See .gitignore.

# Required. The session key for SearXNG. Generate one with:
#   openssl rand -hex 32
SEARXNG_SECRET=

# Optional. The host port for the web interface. The default is 47821.
#SEARXNG_PORT=47821

# Optional. The host address for the web interface. The default is 127.0.0.1,
# so only this computer can open it. Set it to 0.0.0.0 or a Tailscale address
# to serve other devices, then set limiter: true in searxng/settings.yml.
# Other containers reach the instance at http://searxng:8080 on the
# quietsearx_searxng network and do not need this setting.
#SEARXNG_BIND_ADDRESS=127.0.0.1

# Optional. The number of granian blocking threads. The default is 16. A search
# waits on the engine responses, so a low value serializes concurrent searches.
#SEARXNG_GRANIAN_THREADS=16

# Optional. The mean number of seconds between decoy searches.
#COVER_MEAN_INTERVAL=180

# Optional. The User-Agent for decoy searches. Set this to the value that
# your own browser sends, so a decoy looks like a real search.
#COVER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36

# Optional. Set to 1 to write the decoy text to the log. Keep it at 0.
#COVER_LOG_QUERIES=0
